{
  "expo": {
    "name": "VisitorPass",
    "slug": "vms-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "vms",
    "userInterfaceStyle": "dark",
    "owner": "lochanr",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#080c14"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lochanr.vmsmobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.lochanr.vmsmobile",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow VisitorPass to access your camera."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1aac9a7b-c096-4f7f-9942-ff810c0b42ba"
      }
    }
  }
}
